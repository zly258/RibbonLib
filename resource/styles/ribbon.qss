/* RibbonLib default light style.
 * Scoped to RibbonLib widgets only. It must never alter host application widgets.
 */

QRibbonWidget#RibbonWidget {
    background: #ffffff;
    border: none;
    color: #202124;
}

QRibbonWidget#RibbonWidget QWidget#RibbonTopBar {
    background: #f3f4f6;
    border: none;
}

QRibbonWidget#RibbonWidget QToolButton#ApplicationButton {
    padding: 0 12px;
    margin: 0;
    border: none;
    border-radius: 0;
    background: #0072c6;
    color: #ffffff;
}
QRibbonWidget#RibbonWidget QToolButton#ApplicationButton:hover {
    background: #106ebe;
}
QRibbonWidget#RibbonWidget QToolButton#ApplicationButton:pressed,
QRibbonWidget#RibbonWidget QToolButton#ApplicationButton:checked {
    background: #005a9e;
}
QRibbonWidget#RibbonWidget QToolButton#ApplicationButton::menu-indicator {
    image: none;
    width: 0;
}

QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar {
    background: transparent;
    border: none;
    margin: 0;
    padding: 0;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar::tab {
    min-height: 27px;
    padding: 0 15px;
    margin: 1px 0 0 0;
    border: none;
    border-top: 1px solid transparent;
    background: #f3f4f6;
    color: #30343a;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar::tab:hover:!selected {
    background: #e9edf2;
    color: #005fb8;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar::tab:selected {
    min-height: 27px;
    margin-top: 0;
    background: #ffffff;
    border: none;
    border-top: 2px solid #0072c6;
    color: #005fb8;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar::tab:disabled {
    background: transparent;
    color: #8a8f96;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar QToolButton {
    min-width: 18px;
    max-width: 18px;
    min-height: 18px;
    max-height: 18px;
    margin: 0 1px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar QToolButton:hover {
    background: #e3eefb;
    border-color: #a9c9ec;
}
QRibbonWidget#RibbonWidget QTabBar#RibbonTabBar QToolButton:pressed {
    background: #cfe3f8;
    border-color: #87b4e1;
}

QRibbonWidget#RibbonWidget QWidget#RibbonAccessBar {
    background: transparent;
    border: none;
    color: #30343a;
}
QRibbonWidget#RibbonWidget QToolButton#RibbonAccessButton {
    padding: 0 5px;
    margin: 0 1px;
    border: 1px solid transparent;
    border-radius: 2px;
    background: transparent;
    color: #30343a;
}
QRibbonWidget#RibbonWidget QToolButton#RibbonAccessButton:hover {
    background: #e3eefb;
    border-color: #a9c9ec;
    color: #174a7e;
}
QRibbonWidget#RibbonWidget QToolButton#RibbonAccessButton:pressed,
QRibbonWidget#RibbonWidget QToolButton#RibbonAccessButton:checked {
    background: #cfe3f8;
    border-color: #87b4e1;
    color: #123d68;
}
QRibbonWidget#RibbonWidget QToolButton#RibbonAccessButton:disabled {
    background: transparent;
    border-color: transparent;
    color: #8a8f96;
}

QRibbonWidget#RibbonWidget QStackedWidget#RibbonContent {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #dfe3e8;
}
QRibbonWidget#RibbonWidget QWidget#RibbonTabPage,
QRibbonWidget#RibbonWidget QWidget#RibbonTabContent,
QRibbonWidget#RibbonWidget QWidget#RibbonGroupContent,
QRibbonWidget#RibbonWidget QScrollArea#RibbonTabScrollArea,
QRibbonWidget#RibbonWidget QScrollArea#RibbonTabScrollArea QWidget#qt_scrollarea_viewport {
    background: #ffffff;
    border: none;
}

QRibbonWidget#RibbonWidget QFrame#RibbonGroup {
    background: #ffffff;
    border: none;
    border-right: 1px solid #e3e6ea;
}
QRibbonWidget#RibbonWidget QLabel#RibbonGroupTitle {
    min-height: 18px;
    max-height: 18px;
    padding: 0 4px 2px 4px;
    border: none;
    background: #ffffff;
    color: #5f6368;
    qproperty-alignment: AlignCenter;
}
QRibbonWidget#RibbonWidget QFrame#RibbonGroupSeparator {
    color: #e5e8ec;
    background: #e5e8ec;
    border: none;
}

QRibbonWidget#RibbonWidget QWidget#RibbonButton,
QRibbonWidget#RibbonWidget QWidget#RibbonSplitButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    color: #202124;
}
QRibbonWidget#RibbonWidget QWidget#RibbonButton:hover,
QRibbonWidget#RibbonWidget QWidget#RibbonSplitButton:hover {
    background: #eef6ff;
    border-color: #b7d4f6;
}
QRibbonWidget#RibbonWidget QWidget#RibbonButton[pressed="true"],
QRibbonWidget#RibbonWidget QWidget#RibbonSplitButton[pressed="true"] {
    background: #d7ebff;
    border-color: #7fb7e8;
}
QRibbonWidget#RibbonWidget QWidget#RibbonButton[checked="true"],
QRibbonWidget#RibbonWidget QWidget#RibbonSplitButton[checked="true"] {
    background: #dbeeff;
    border-color: #6aa9df;
    color: #123d68;
}
QRibbonWidget#RibbonWidget QWidget#RibbonButton:disabled,
QRibbonWidget#RibbonWidget QWidget#RibbonSplitButton:disabled {
    color: #8a8f96;
    background: transparent;
    border-color: transparent;
}

QRibbonWidget#RibbonWidget QScrollBar:horizontal,
QRibbonTab QScrollBar:horizontal,
QWidget#RibbonTabPage QScrollBar:horizontal {
    height: 0;
    margin: 0;
    border: none;
    background: transparent;
}

QMenu#RibbonMenu,
QMenu#RibbonSplitMenu,
QMenu#RibbonApplicationMenu {
    background: #ffffff;
    color: #202124;
    border: 1px solid #c8ccd2;
    padding: 1px;
}
QMenu#RibbonMenu::item,
QMenu#RibbonSplitMenu::item,
QMenu#RibbonApplicationMenu::item {
    min-height: 20px;
    padding: 2px 10px 2px 18px;
    background: transparent;
    border: 1px solid transparent;
}
QMenu#RibbonApplicationMenu::item {
    min-height: 22px;
    padding: 3px 10px 3px 18px;
}
QMenu#RibbonMenu::item:selected,
QMenu#RibbonSplitMenu::item:selected,
QMenu#RibbonApplicationMenu::item:selected {
    background: #e8f2ff;
    border-color: #b7d4f6;
    color: #202124;
}
QMenu#RibbonMenu::item:disabled,
QMenu#RibbonSplitMenu::item:disabled,
QMenu#RibbonApplicationMenu::item:disabled {
    color: #8a8f96;
}
QMenu#RibbonMenu::separator,
QMenu#RibbonSplitMenu::separator,
QMenu#RibbonApplicationMenu::separator {
    height: 1px;
    background: #d8dde3;
    margin: 2px 4px;
}
QMenu#RibbonMenu::indicator,
QMenu#RibbonSplitMenu::indicator,
QMenu#RibbonApplicationMenu::indicator {
    width: 12px;
    height: 12px;
}
